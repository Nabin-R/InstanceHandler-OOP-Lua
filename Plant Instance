local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")

ReplicatedStorage["Game Object"].FX:WaitForChild("Rare")
ReplicatedStorage["Game Object"].FX:WaitForChild("Bottom")

local PlantData = require(script.Parent.PlantData)
local DataMGR = require(ServerScriptService.Data.DataHandler)
local SessionHandler = require(ServerScriptService.Data.DataHandler.SessionHandler)
local ResourceModule = require(ServerStorage.Database.Resource)
local EventModule = require(ServerScriptService.Game.Events)
local MutationModule = require(ReplicatedStorage.Database.Mutation)

-- Settings
local DefaultMutationChance = 0.12
local DefaultShinySparklingChance = 0.08
local MaxResourceChance = 0.3

local PlantInstance = {}
PlantInstance.__index = PlantInstance

function PlantInstance.new(plantName, locationName)
	local data = PlantData[plantName]
	if not data then return end

	local template = ReplicatedStorage["Game Object"]:FindFirstChild(plantName)
	if not template then return end
	
	local template = template:GetChildren()
	local self = setmetatable({}, PlantInstance)

	self.Id = HttpService:GenerateGUID(false)
	self.Name = plantName
	self.Location = locationName
	self.Data = data
	self.Data.Rare = math.random() < 0.12 and true or false
	
	local count = 0
	
	for i = 1, #template do
		count +=1
	end
	
	local newTemplate = template[math.random(1, count)]
	
	self.Model = newTemplate:Clone()
	self.Model.Parent = workspace.Spawns
	self.Model.Name = self.Location.." - "..self.Name
	if self.Data.Rare then
		local Rare = ReplicatedStorage["Game Object"].FX.Rare:Clone()
		local Bottom = ReplicatedStorage["Game Object"].FX.Bottom:Clone()
		Bottom.Position = Vector3.new(0,-self.Model.Main.Size.Y/2,0)
		Rare.Parent = self.Model.Main
		Bottom.Parent = self.Model.Main
		Bottom.Aura:Play()
	end

	self.Model.Main:SetAttribute("SpawnId", self.Id)
	self.Model.Main:SetAttribute("Location", self.Location)
	self.Model.Main:SetAttribute("PlantName", self.Name)
	
	self.Model.Main:SetAttribute("isAvailable", true)
	self.Model.Main:SetAttribute("SpawnType", data.SpawnType)
	
	return self
end


function PlantInstance:Destroy()
	if self.Model then
		self.Model:Destroy()
		self.Model = nil
	end

	-- clear references
	self.Data = nil
end

local function generateUniqueId()
	return HttpService:GenerateGUID(false)
end
local function round2(num)
	return math.floor(num * 100 + 0.5) / 100
end

local function RandomMutation(player, arg)
	local roll = math.random(1,100) 
	local currentMutationCategory = MutationModule["Natural Mutation"]
	local holder = {}

	local multiplier = 1

	if arg == "Appraisal" then
		if player:GetAttribute("HasAppraisalLuckPass") then
			multiplier = 1.5
		end
	else multiplier = 1 end


	if roll < (8 * multiplier) then
		for k, v in pairs(currentMutationCategory) do
			if v[1] > 5 then
				table.insert(holder, k)
			end
		end
		math.random(1, #holder)
	elseif roll < (32 * multiplier) then
		for k, v in pairs(currentMutationCategory) do
			if v[1] >= 2 and v[1] < 5 then
				table.insert(holder, k)
			end
		end
	else
		for k, v in pairs(currentMutationCategory) do
			if v[1] < 2 then
				table.insert(holder, k)
			end
		end
	end
	local mutationreturn = holder[math.random(1, #holder)]
	return mutationreturn
end

function PlantInstance:RollItem(player)
	
	local profile = DataMGR.Profiles[player]
	local statsProfile = DataMGR.Stats[player]
	local session = SessionHandler:GetSessionInfo(player)

	local mutationTable = {
		Base = {},
		Natural = "",
		Weather = ""
	}

	local itemselect = nil
	local fallback = { 
		itemName = "Dirt", 
		itemCategory = "Resource",
		itemId = generateUniqueId(),
		itemMutation = mutationTable,
		itemWeight = 0.01,
		itemFavourite = false
	}

	-- Fallback
	if not profile or not statsProfile or not player or not session then 
		print("Failuire to retrieve Item:", session)
		return fallback
	end

	local LuckMultiplier = self.Data.Rare and 1.1 or 1
	local MutationMultiplier = self.Data.Rare and 1.1 or 1
	local ShinySparkling = self.Data.Rare and 0.25 or 0.08
	local PetMutation = false

	local itemPool = self.Data.DefaultPool
	local luck = statsProfile.Luck + 0 or 0
	local chosen = {}
	local Quantity = 1

	local function getWeightedMultiplier()
		local roll = math.random() 

		if roll <= 0.0003 then
			return math.random() * (9 - 6) + 6
		elseif roll <= 0.001 then
			return math.random() * (5 - 4) + 4
		elseif roll <= 0.01 then
			return math.random() * (3.5 - 2.5) + 2.5
		elseif roll <= 0.93 then
			return math.random() * (1.85 - 0.8) + 0.85
		else
			return math.random() * (0.8 - 0.65) + 0.65
		end
	end
	
	local function CreateTable(itemName, data)

		local sizebonus = statsProfile["Size Bonus"] and (1 + (statsProfile["Size Bonus"]/100)) or 1
		local itemFav = profile.Data.Settings["AL_"..data.Rarity]

		local function WeatherCheck()
			if EventModule.CurrentWeather == "" then return "" end
			if math.random() < EventModule.Weather[EventModule.WeatherType][EventModule.CurrentWeather].MutationChance then
				return EventModule.Weather[EventModule.WeatherType][EventModule.CurrentWeather].Mutation
			else
				return ""
			end
		end

		local baseMutations = {}
		if math.random() < ShinySparkling then
			table.insert(baseMutations, "Shiny")
		end
		if math.random() < ShinySparkling then
			table.insert(baseMutations, "Sparkling")
		end

		local mutTable = {
			Base = baseMutations,
			Natural = math.random() < 0.12 and RandomMutation(player, "Foraging") or "",
			Weather = WeatherCheck()
		}
		local newItem = {
			itemName = itemName,
			itemCategory = "Resource",
			itemId = generateUniqueId(),
			itemMutation = mutTable,
			itemWeight = round2(data.BaseWeight * getWeightedMultiplier() * sizebonus),
			itemFavourite = itemFav or false,
		}
		table.insert(chosen, newItem)
	end

	-- Sort pool so rarest items come first (lowest Chance)
	table.sort(itemPool, function(a, b)
		local dataA = ResourceModule[a]
		local dataB = ResourceModule[b]
		return dataA.Chance < dataB.Chance
	end)

	local validPool = {}
	for _, itemName in ipairs(itemPool) do
		local data = ResourceModule[itemName]
		table.insert(validPool, itemName)
	end
	
	local Quantity = math.clamp(
		math.random() < MaxResourceChance and self.Data.MaxResource or self.Data.MaxResource - 1,
		1,
		self.Data.MaxResource)
	
	for i = 1, Quantity do
		for key, itemName in ipairs(validPool) do
			local data = ResourceModule[itemName]
			local maxChance = (key == #validPool) and 1 or 0.8
			local currentChance = (data.Chance * luck)/100
			if math.random() <= math.min(maxChance, currentChance) then
				Quantity = 1
				CreateTable(itemName, data)
				break
			else
				if key == #validPool then
					print("Pity'd entire pool")
					CreateTable(itemName, data)
					break
				end

			end
		end
	end

	-- If nothing was picked, fallback
	if not chosen or not chosen[1] then
		SessionHandler:AddLoot(fallback)
		print("Checks Failed, Fallback issued.")
	end
	SessionHandler:GetSessionInfo(player)
	return chosen
	
end

return PlantInstance
